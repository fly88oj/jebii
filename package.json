{
  "name": "jebii",
  "version": "0.1.0",
  "description": "Live2D character chat in the browser: Jev decides the emotion, SoulLink performs it",
  "author": "jebii contributors",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "gen:profile": "node scripts/gen-profile.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/web-assets.mjs && node scripts/web-compress.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && node --check src/main.js"
  },
  "dependencies": {
    "@soullink-emotion/engine": "0.1.0-beta.1",
    "@soullink-emotion/live2d-pixi": "0.1.0-beta.1",
    "@soullink-emotion/planner-openai": "0.1.0-beta.1",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.4.3"
  },
  "devDependencies": {
    "@soullink-emotion/profile-generator": "0.1.0-beta.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
